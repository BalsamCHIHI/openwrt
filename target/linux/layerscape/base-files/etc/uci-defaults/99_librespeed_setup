echo "librespeed_setup : librespeed setup started." > /dev/kmsg

uci set librespeed-go.config.enabled='1'           # Enable the daemon in UCI
uci set librespeed-go.config.bind_address=''       # bind all interfaces
uci set librespeed-go.config.listen_port='8989'    # or pick another free port
uci set librespeed-go.config.database_type='none'  # no telemetry (lightest)

uci commit librespeed-go
reload_config

/etc/init.d/librespeed-go stop
/etc/init.d/librespeed-go disable

echo "librespeed_setup : librespeed setup completed." > /dev/kmsg

exit 0
