#!/bin/sh /etc/rc.common

START=98
USE_PROCD=1

boot() {
    echo "dpaa2_setup : DPAA2 network interfaces setup started." > /dev/kmsg

    ls-addni dpmac.2
    ls-addni dpmac.3
    ls-addni dpmac.4
    ls-addni dpmac.5
    ls-addni dpmac.6
    ls-addni dpmac.7
    ls-addni dpmac.8
    ls-addni dpmac.9
    ls-addni dpmac.10

    echo "dpaa2_setup : DPAA2 network interfaces setup completed." > /dev/kmsg
}
