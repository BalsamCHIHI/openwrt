#!/bin/sh /etc/rc.common

START=98

boot() {
    echo "dpaa2_setup : DPAA2 network interfaces setup started." > /dev/kmsg

    for i in $(seq 2 10); do
        dpmac="dpmac.$i"
        echo "Creating DPNI for $dpmac..." > /dev/kmsg
        ls-addni "$dpmac"
    done

    echo "dpaa2_setup : DPAA2 network interfaces setup completed." > /dev/kmsg

    return 0
}
