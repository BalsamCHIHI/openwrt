#!/bin/sh /etc/rc.common

START=94
USE_PROCD=1

boot() {
    echo "system_setup : System setup started." > /dev/kmsg

    MARKER_FILE="/etc/system_setup_done"

    if [ -f "$MARKER_FILE" ]; then
        return 0
    fi

    board=$(cat /proc/cmdline | awk -F'board=' '{print $2}' | awk '{print $1}')
    variant=$(cat /proc/cmdline | awk -F'variant=' '{print $2}' | awk '{print $1}')
    mac_suffix=$(cat /proc/cmdline | awk -F'mac_suffix=' '{print $2}' | awk '{print $1}')

    # Replace missing values with "variable name" string
    [ -z "$board" ] && board="board"
    [ -z "$variant" ] && variant="variant"
    [ -z "$mac_suffix" ] && mac_suffix="mac_suffix"

    hostname="Connect-${board}-${variant}-${mac_suffix}"

    uci set system.@system[0].hostname="$hostname"
    uci set system.@system[0].log_size='1024'
    uci set system.@system[0].zonename='UTC'
    uci set system.@system[0].log_ip='10.10.0.190'
    uci set system.@system[0].log_port='514'
    uci set system.@system[0].log_proto='tcp'
    uci set system.@system[0].log_file='/tmp/system.log'
    uci set system.@system[0].conloglevel='8'
    uci set system.@system[0].cronloglevel='5'

    uci commit
    reload_config

    touch "$MARKER_FILE"

    echo "system_setup : hostname = $hostname." > /dev/kmsg
    echo "system_setup : System setup completed." > /dev/kmsg
}
