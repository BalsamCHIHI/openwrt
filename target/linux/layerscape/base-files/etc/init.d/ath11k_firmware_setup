#!/bin/sh /etc/rc.common

START=01
USE_PROCD=1

boot() {
    echo "ath11k_firmware_setup : ATH11K Firmware setup started." > /dev/kmsg

    bname=$(cat /proc/cmdline | awk -F'bname=' '{print $2}' | awk '{print $1}')

    if [ -z "$bname" ]; then
        echo "ath11k_firmware_setup : bname variable not found, Ath11k Firmware setup failed." > /dev/kmsg

        return 1
    fi

    case "$bname" in
        COMPEX | Compex | compex)
            SOURCE_1="/lib/firmware/ath11k/QCN9074/hw1.0/compex/fwcfg-pci-0000:01:00.0.txt"
            SOURCE_2="/lib/firmware/ath11k/QCN9074/hw1.0/compex/fwcfg-pci-0001:01:00.0.txt"
            ;;
        8DEVICES | 8devices)
            SOURCE_1="/lib/firmware/ath11k/QCN9074/hw1.0/8devices/fwcfg-pci-0000:01:00.0.txt"
            SOURCE_2="/lib/firmware/ath11k/QCN9074/hw1.0/8devices/fwcfg-pci-0001:01:00.0.txt"
            ;;
        *)
            echo "ath11k_firmware_setup : Unknown bname = $bname, skipping ath11k firmware setup." > /dev/kmsg

            return 0
            ;;
    esac

    TARGET_1="/lib/firmware/ath11k/fwcfg-pci-0000:01:00.0.txt"
    TARGET_2="/lib/firmware/ath11k/fwcfg-pci-0001:01:00.0.txt"

    ln -sf "$SOURCE_1" "$TARGET_1"
    ln -sf "$SOURCE_2" "$TARGET_2"

    echo "ath11k_firmware_setup : bname = $bname, Ath11k Firmware setup completed." > /dev/kmsg

    return 0
}
