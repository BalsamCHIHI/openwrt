/dts-v1/;

/ {
	compatible = "moment,ls1088a-tqmls1088a-connect", "moment,ls1088a-tqmls1088a", "tq,ls1088a-tqmls1088a-mbls10xxa", "tq,ls1088a-tqmls1088a", "fsl,ls1088a";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Moment LS1088A TQMLS1088A SoM on Connect board";

	aliases {
		crypto = "/soc/crypto@8000000";
		serial0 = "/soc/serial@21c0500";
		serial1 = "/soc/serial@21c0600";
		serial2 = "/soc/serial@21d0500";
		serial3 = "/soc/serial@21d0600";
		gpio_expander = &pca9555;
	};

	ram {
		reg = <0x00 0x80000000 0x00 0x7BE00000>;
		device_type = "memory";
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x00>;
			clocks = <0x02 0x01 0x00>;
			cpu-idle-states = <0x03>;
			#cooling-cells = <0x02>;
			phandle = <0x06>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x01>;
			clocks = <0x02 0x01 0x00>;
			cpu-idle-states = <0x03>;
			#cooling-cells = <0x02>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x02>;
			clocks = <0x02 0x01 0x00>;
			cpu-idle-states = <0x03>;
			#cooling-cells = <0x02>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x03>;
			clocks = <0x02 0x01 0x00>;
			cpu-idle-states = <0x03>;
			#cooling-cells = <0x02>;
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x100>;
			clocks = <0x02 0x01 0x01>;
			cpu-idle-states = <0x03>;
			#cooling-cells = <0x02>;
			phandle = <0x07>;
		};

		cpu@101 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x101>;
			clocks = <0x02 0x01 0x01>;
			cpu-idle-states = <0x03>;
			#cooling-cells = <0x02>;
		};

		cpu@102 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x102>;
			clocks = <0x02 0x01 0x01>;
			cpu-idle-states = <0x03>;
			#cooling-cells = <0x02>;
		};

		cpu@103 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x103>;
			clocks = <0x02 0x01 0x01>;
			cpu-idle-states = <0x03>;
			#cooling-cells = <0x02>;
		};

		cpu-ph20 {
			compatible = "arm,idle-state";
			idle-state-name = "PH20";
			arm,psci-suspend-param = <0x00>;
			entry-latency-us = <0x3e8>;
			exit-latency-us = <0x3e8>;
			min-residency-us = <0xbb8>;
			phandle = <0x03>;
		};
	};

	interrupt-controller@6000000 {
		compatible = "arm,gic-v3";
		#interrupt-cells = <0x03>;
		interrupt-controller;
		reg = <0x00 0x6000000 0x00 0x10000 0x00 0x6100000 0x00 0x100000 0x00 0xc0c0000 0x00 0x2000 0x00 0xc0d0000 0x00 0x1000 0x00 0xc0e0000 0x00 0x20000>;
		interrupts = <0x01 0x09 0x04>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x01>;

		gic-its@6020000 {
			compatible = "arm,gic-v3-its";
			msi-controller;
			reg = <0x00 0x6020000 0x00 0x20000>;
			phandle = <0x12>;
		};
	};

	thermal-zones {

		thermal-zone0 {
			polling-delay-passive = <0x3e8>;
			polling-delay = <0x1388>;
			thermal-sensors = <0x04 0x00>;
			status = "okay";

			trips {

				alert0 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x05>;
				};

				crit0 {
					temperature = <0x186A0>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x05>;
					cooling-device = <0x06 0xffffffff 0xffffffff>;
				};

				map1 {
					trip = <0x05>;
					cooling-device = <0x07 0xffffffff 0xffffffff>;
				};
			};
		};

		thermal-zone1 {
			polling-delay-passive = <0x3e8>;
			polling-delay = <0x1388>;
			thermal-sensors = <0x04 0x01>;
			status = "okay";

			trips {

				alert1 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x08>;
				};

				crit1 {
					temperature = <0x186A0>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x08>;
					cooling-device = <0x06 0xffffffff 0xffffffff>;
				};

				map1 {
					trip = <0x08>;
					cooling-device = <0x07 0xffffffff 0xffffffff>;
				};
			};
		};

		thermal-zone2 {
			polling-delay-passive = <0x3e8>;
			polling-delay = <0x1388>;
			thermal-sensors = <0x04 0x02>;
			status = "disabled";

			trips {

				alert2 {
					temperature = <0x124f8>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x09>;
				};

				crit2 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x09>;
					cooling-device = <0x06 0xffffffff 0xffffffff>;
				};

				map1 {
					trip = <0x09>;
					cooling-device = <0x07 0xffffffff 0xffffffff>;
				};
			};
		};

		thermal-zone3 {
			polling-delay-passive = <0x3e8>;
			polling-delay = <0x1388>;
			thermal-sensors = <0x04 0x03>;
			status = "disabled";

			trips {

				alert3 {
					temperature = <0x124f8>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x0a>;
				};

				crit3 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x0a>;
					cooling-device = <0x06 0xffffffff 0xffffffff>;
				};

				map1 {
					trip = <0x0a>;
					cooling-device = <0x07 0xffffffff 0xffffffff>;
				};
			};
		};

		thermal-zone4 {
			polling-delay-passive = <0x3e8>;
			polling-delay = <0x1388>;
			thermal-sensors = <0x04 0x04>;
			status = "disabled";

			trips {

				alert4 {
					temperature = <0x124f8>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x0b>;
				};

				crit4 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x0b>;
					cooling-device = <0x06 0xffffffff 0xffffffff>;
				};

				map1 {
					trip = <0x0b>;
					cooling-device = <0x07 0xffffffff 0xffffffff>;
				};
			};
		};

		thermal-zone5 {
			polling-delay-passive = <0x3e8>;
			polling-delay = <0x1388>;
			thermal-sensors = <0x04 0x05>;
			status = "disabled";

			trips {

				alert5 {
					temperature = <0x124f8>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x0c>;
				};

				crit5 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x0c>;
					cooling-device = <0x06 0xffffffff 0xffffffff>;
				};

				map1 {
					trip = <0x0c>;
					cooling-device = <0x07 0xffffffff 0xffffffff>;
				};
			};
		};

		thermal-zone6 {
			polling-delay-passive = <0x3e8>;
			polling-delay = <0x1388>;
			thermal-sensors = <0x04 0x06>;
			status = "disabled";

			trips {

				alert6 {
					temperature = <0x124f8>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x0d>;
				};

				crit6 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x0d>;
					cooling-device = <0x06 0xffffffff 0xffffffff>;
				};

				map1 {
					trip = <0x0d>;
					cooling-device = <0x07 0xffffffff 0xffffffff>;
				};
			};
		};

		thermal-zone7 {
			polling-delay-passive = <0x3e8>;
			polling-delay = <0x1388>;
			thermal-sensors = <0x04 0x07>;
			status = "disabled";

			trips {

				alert7 {
					temperature = <0x124f8>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x0e>;
				};

				crit7 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x0e>;
					cooling-device = <0x06 0xffffffff 0xffffffff>;
				};

				map1 {
					trip = <0x0e>;
					cooling-device = <0x07 0xffffffff 0xffffffff>;
				};
			};
		};
	};

	vcc_3v3: regulator-vcc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};


	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0x08 0x01 0x0e 0x08 0x01 0x0b 0x08 0x01 0x0a 0x08>;
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	sysclk {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x5f5e100>;
		clock-output-names = "sysclk";
		phandle = <0x10>;
	};

	syscon@1e60000 {
		compatible = "fsl,ls1088a-rstcr\0syscon";
		reg = <0x00 0x1e60000 0x00 0x04>;
		phandle = <0x0f>;
	};

	reboot {
		compatible = "syscon-reboot";
		regmap = <0x0f>;
		offset = <0x00>;
		mask = <0x02>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		dma-ranges = <0x00 0x00 0x00 0x00 0x10000 0x00>;

		clocking@1300000 {
			compatible = "fsl,ls1088a-clockgen";
			reg = <0x00 0x1300000 0x00 0xa0000>;
			#clock-cells = <0x02>;
			clocks = <0x10>;
			phandle = <0x02>;
		};

		dcfg@1e00000 {
			compatible = "fsl,ls1088a-dcfg\0syscon";
			reg = <0x00 0x1e00000 0x00 0x10000>;
			little-endian;
		};

		tmu@1f80000 {
			compatible = "fsl,qoriq-tmu";
			reg = <0x00 0x1f80000 0x00 0x10000>;
			interrupts = <0x00 0x17 0x04>;
			fsl,tmu-range = <0xb0000 0x9002a 0x6004c 0x30062>;
			fsl,tmu-calibration = <0x00 0x26 0x01 0x2d 0x02 0x32 0x03 0x39 0x04 0x3f 0x05 0x46 0x06 0x4d 0x07 0x54 0x08 0x5a 0x09 0x61 0x0a 0x6a 0x0b 0x71 0x10000 0x25 0x10001 0x2c 0x10002 0x35 0x10003 0x3d 0x10004 0x45 0x10005 0x4e 0x10006 0x57 0x10007 0x61 0x10008 0x6b 0x10009 0x76 0x20000 0x29 0x20001 0x33 0x20002 0x3d 0x20003 0x49 0x20004 0x56 0x20005 0x61 0x20006 0x6d 0x30000 0x21 0x30001 0x2a 0x30002 0x3c 0x30003 0x4e>;
			little-endian;
			#thermal-sensor-cells = <0x01>;
			phandle = <0x04>;
		};

		serial@21c0500 {
			compatible = "fsl,ns16550\0ns16550a";
			reg = <0x00 0x21c0500 0x00 0x100>;
			clocks = <0x02 0x04 0x01>;
			interrupts = <0x00 0x20 0x04>;
			status = "okay";
		};

		serial@21c0600 {
			compatible = "fsl,ns16550\0ns16550a";
			reg = <0x00 0x21c0600 0x00 0x100>;
			clocks = <0x02 0x04 0x01>;
			interrupts = <0x00 0x20 0x04>;
			status = "okay";
		};

		serial@21d0500 {
			compatible = "fsl,ns16550\0ns16550a";
			reg = <0x00 0x21d0500 0x00 0x100>;
			clocks = <0x02 0x04 0x01>;
			interrupts = <0x00 0x21 0x04>;
			status = "okay";
		};

		serial@21d0600 {
			compatible = "fsl,ns16550\0ns16550a";
			reg = <0x00 0x21d0600 0x00 0x100>;
			clocks = <0x02 0x04 0x01>;
			interrupts = <0x00 0x21 0x04>;
			status = "okay";
		};

		gpio@2300000 {
			compatible = "fsl,qoriq-gpio";
			reg = <0x00 0x2300000 0x00 0x10000>;
			interrupts = <0x00 0x24 0x04>;
			little-endian;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
		};

		gpio@2310000 {
			compatible = "fsl,qoriq-gpio";
			reg = <0x00 0x2310000 0x00 0x10000>;
			interrupts = <0x00 0x24 0x04>;
			little-endian;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
		};

		gpio@2320000 {
			compatible = "fsl,qoriq-gpio";
			reg = <0x00 0x2320000 0x00 0x10000>;
			interrupts = <0x00 0x25 0x04>;
			little-endian;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
		};

		gpio@2330000 {
			compatible = "fsl,qoriq-gpio";
			reg = <0x00 0x2330000 0x00 0x10000>;
			interrupts = <0x00 0x25 0x04>;
			little-endian;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x11>;
		};

		mdio@8B96000 {
			compatible = "fsl,fman-memac-mdio";
			reg = <0x00 0x8b96000 0x00 0x1000>;
			device_type = "mdio";
			little-endian;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			mdio1_phy4: emdio1_phy@04 {
                		reg = <0x04>;
				media = "fiber";
            		};

            		mdio1_phy5: emdio1_phy@05 {
                		reg = <0x05>;
				media = "fiber";
            		};

            		mdio1_phy6: emdio1_phy@06 {
                		reg = <0x06>;
				media = "copper";
            		};

            		mdio1_phy7: emdio1_phy@07 {
                		reg = <0x07>;
				media = "copper";
            		};

            		mdio1_phy8: emdio1_phy@08 {
                		reg = <0x08>;
				media = "fiber";
            		};

            		mdio1_phy9: emdio1_phy@09 {
                		reg = <0x09>;
				media = "fiber";
            		};

            		mdio1_phy10: emdio1_phy@0a {
                		reg = <0x0a>;
				media = "fiber";
            		};

            		mdio1_phy11: emdio1_phy@0b {
                		reg = <0x0b>;
				media = "fiber";
            		};
		};

		mdio@8B97000 {
			compatible = "fsl,fman-memac-mdio";
			reg = <0x00 0x8b97000 0x00 0x1000>;
			device_type = "mdio";
			little-endian;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
		};

		ifc@2240000 {
			compatible = "fsl,ifc\0simple-bus";
			reg = <0x00 0x2240000 0x00 0x20000>;
			interrupts = <0x00 0x15 0x04>;
			little-endian;
			#address-cells = <0x02>;
			#size-cells = <0x01>;
			status = "disabled";
		};

		ftm0@2800000 {
			compatible = "fsl,ls1088a-ftm-alarm";
			reg = <0x00 0x2800000 0x00 0x10000 0x00 0x1e34050 0x00 0x04>;
			reg-names = "ftm\0pmctrl";
			interrupts = <0x00 0x2c 0x04>;
		};

		i2c@2000000 {
			compatible = "fsl,vf610-i2c\0fsl,ls1088a-vf610-i2c";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x00 0x2000000 0x00 0x10000>;
			interrupts = <0x00 0x22 0x04>;
			clocks = <0x02 0x04 0x07>;
			scl-gpios = <0x11 0x1e 0x00>;
			status = "okay";

			temp-sensor@18 {
				compatible = "jc42";
				reg = <0x18>;
			};

			eeprom@50 {
				compatible = "atmel,24c02";
				reg = <0x50>;
			};

			rtc@51 {
				compatible = "nxp,pcf85063";
				reg = <0x51>;
			};

			eeprom@57 {
				compatible = "atmel,24c256";
				reg = <0x57>;
			};

			at24cs01@54 {
				compatible = "atmel,24c01";
				label = "mb-eeprom";
				reg = <0x54>;
			};
			at24cs01@5c {
				compatible = "atmel,24cs01";
				label = "mb-uuid";
				reg = <0x5c>;
			};

			at24cs01@55 {
				compatible = "atmel,24c01";
				label = "db-eeprom";
				reg = <0x55>;
			};
			at24cs01@5d {
				compatible = "atmel,24cs01";
				label = "db-uuid";
				reg = <0x5d>;
			};

			at24cs01@52 {
				compatible = "atmel,24c01";
				label = "ant-eeprom";
				reg = <0x52>;
			};
			at24cs01@5a {
				compatible = "atmel,24cs01";
				label = "ant-uuid";
				reg = <0x5a>;
			};

			pca9555: pca9555@20 {
				compatible = "nxp,pca9555";
				gpio-controller;
				#gpio-cells = <2>;
				reg = <0x20>;
				gpio-base = <0>;
			};

			ads7830@4a {
				label = "mb-sensor-adc";
				compatible = "ti,ads7830";
				reg = <0x4a>;
			};

			ads7830@4b {
				label = "db-sensor-adc";
				compatible = "ti,ads7830";
				reg = <0x4b>;
				vref-supply = <&vcc_3v3>;
			};

			tmp1075@48 {
				label = "mb-sensor-temperature";
				compatible = "ti,tmp1075";
				reg = <0x48>;
			};

			tmp1075@49 {
				label = "db-sensor-temperature";
				compatible = "ti,tmp1075";
				reg = <0x49>;
			};
		};

		i2c@2010000 {
			compatible = "fsl,vf610-i2c";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x00 0x2010000 0x00 0x10000>;
			interrupts = <0x00 0x22 0x04>;
			clocks = <0x02 0x04 0x07>;
			status = "disabled";
		};

		i2c@2020000 {
			compatible = "fsl,vf610-i2c";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x00 0x2020000 0x00 0x10000>;
			interrupts = <0x00 0x23 0x04>;
			clocks = <0x02 0x04 0x07>;
			status = "disabled";
		};

		i2c@2030000 {
			compatible = "fsl,vf610-i2c";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x00 0x2030000 0x00 0x10000>;
			interrupts = <0x00 0x23 0x04>;
			clocks = <0x02 0x04 0x07>;
			status = "okay";
		};

		esdhc@2140000 {
			compatible = "fsl,ls1088a-esdhc\0fsl,esdhc";
			reg = <0x00 0x2140000 0x00 0x10000>;
			interrupts = <0x00 0x1c 0x04>;
			clocks = <0x02 0x02 0x01>;
			voltage-ranges = <0x708 0x708 0xce4 0xce4>;
			sdhci,auto-cmd12;
			little-endian;
			bus-width = <0x04>;
			status = "okay";
			non-removable;
			disable-wp;
			mmc-hs200-1_8v;
			sd-uhs-sdr104;
			sd-uhs-sdr50;
			sd-uhs-sdr25;
			sd-uhs-sdr12;
			cd-gpios = <0x11 0x0c 0x01>;
			wp-gpios = <0x11 0x0d 0x00>;
		};

		usb3@3100000 {
			compatible = "snps,dwc3";
			reg = <0x00 0x3100000 0x00 0x10000>;
			interrupts = <0x00 0x50 0x04>;
			dr_mode = "host";
			snps,quirk-frame-length-adjustment = <0x20>;
			snps,dis_rxdet_inp3_quirk;
			status = "okay";
			snps,incr-burst-type-adjustment = <0x01 0x04 0x08 0x10>;
			snps,host-vbus-glitches;
		};

		usb3@3110000 {
			compatible = "snps,dwc3";
			reg = <0x00 0x3110000 0x00 0x10000>;
			interrupts = <0x00 0x51 0x04>;
			dr_mode = "otg";
			snps,quirk-frame-length-adjustment = <0x20>;
			snps,dis_rxdet_inp3_quirk;
			status = "okay";
			snps,incr-burst-type-adjustment = <0x01 0x04 0x08 0x10>;
			snps,host-vbus-glitches;
		};

		sata@3200000 {
			compatible = "fsl,ls1088a-ahci";
			reg = <0x00 0x3200000 0x00 0x10000 0x07 0x100520 0x00 0x04>;
			reg-names = "ahci\0sata-ecc";
			interrupts = <0x00 0x85 0x04>;
			clocks = <0x02 0x04 0x01>;
			dma-coherent;
			status = "okay";
		};

		spi@20c0000 {
			compatible = "fsl,ls2080a-qspi\0fsl,ls1088a-qspi";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x00 0x20c0000 0x00 0x10000 0x00 0x20000000 0x00 0x10000000>;
			reg-names = "QuadSPI\0QuadSPI-memory";
			interrupts = <0x00 0x19 0x04>;
			clocks = <0x02 0x04 0x03 0x02 0x04 0x03>;
			clock-names = "qspi_en\0qspi";
			num-cs = <0x02>;
			bus-num = <0x00>;
			status = "okay";
			fsl,qspi-has-second-chip;

			mx66u51235f@0 {
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				compatible = "jedec,spi-nor";
				spi-max-frequency = <0x3b9aca0>;
				reg = <0x00>;

				partitions {
					compatible = "fixed-partitions";
					#address-cells = <0x01>;
					#size-cells = <0x01>;

					rcwpbi@00000000 {
						label = "rcwpbi";
						reg = <0x00000000 0x00100000>;
					};

					uboot@00100000 {
						label = "uboot";
						reg = <0x00100000 0x00300000>;
					};

					env@00400000 {
						label = "env";
						reg = <0x00400000 0x00020000>;
					};

					dpaadpl@00420000 {
						label = "envbackup";
						reg = <0x00420000 0x00020000>;
					};

					dpaadpc@00500000 {
						label = "mcfw";
						reg = <0x00500000 0x00300000>;
					};

					mcfw@00800000 {
						label = "dpaadpc";
						reg = <0x00800000 0x00100000>;
					};

					dtb@00900000 {
						label = "dpaadpl";
						reg = <0x00900000 0x00100000>;
					};
				};
			};

			mx66u51235f@1 {
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				compatible = "jedec,spi-nor";
				spi-max-frequency = <0x3b9aca0>;
				reg = <0x01>;
			};
		};

		crypto@8000000 {
			compatible = "fsl,sec-v5.0\0fsl,sec-v4.0";
			fsl,sec-era = <0x08>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges = <0x00 0x00 0x8000000 0x100000>;
			reg = <0x00 0x8000000 0x00 0x100000>;
			interrupts = <0x00 0x8b 0x04>;
			dma-coherent;

			jr@10000 {
				compatible = "fsl,sec-v5.0-job-ring\0fsl,sec-v4.0-job-ring";
				reg = <0x10000 0x10000>;
				interrupts = <0x00 0x8c 0x04>;
			};

			jr@20000 {
				compatible = "fsl,sec-v5.0-job-ring\0fsl,sec-v4.0-job-ring";
				reg = <0x20000 0x10000>;
				interrupts = <0x00 0x8d 0x04>;
			};

			jr@30000 {
				compatible = "fsl,sec-v5.0-job-ring\0fsl,sec-v4.0-job-ring";
				reg = <0x30000 0x10000>;
				interrupts = <0x00 0x8e 0x04>;
			};

			jr@40000 {
				compatible = "fsl,sec-v5.0-job-ring\0fsl,sec-v4.0-job-ring";
				reg = <0x40000 0x10000>;
				interrupts = <0x00 0x8f 0x04>;
			};
		};

		pcie@3400000 {
			compatible = "fsl,ls1088a-pcie\0snps,dw-pcie";
			reg = <0x00 0x3400000 0x00 0x100000 0x20 0x00 0x00 0x2000>;
			reg-names = "regs\0config";
			interrupts = <0x00 0x6c 0x04>;
			interrupt-names = "aer";
			#address-cells = <0x03>;
			#size-cells = <0x02>;
			device_type = "pci";
			dma-coherent;
			num-lanes = <0x04>;
			bus-range = <0x00 0xff>;
			ranges = <0x81000000 0x00 0x00 0x20 0x10000 0x00 0x10000 0x82000000 0x00 0x40000000 0x20 0x40000000 0x00 0x40000000>;
			msi-parent = <0x12>;
			iommu-map = <0x00 0x13 0x00 0x01>;
			#interrupt-cells = <0x01>;
			interrupt-map-mask = <0x00 0x00 0x00 0x07>;
			interrupt-map = <0x00 0x00 0x00 0x01 0x01 0x00 0x00 0x00 0x6d 0x04 0x00 0x00 0x00 0x02 0x01 0x00 0x00 0x00 0x6e 0x04 0x00 0x00 0x00 0x03 0x01 0x00 0x00 0x00 0x6f 0x04 0x00 0x00 0x00 0x04 0x01 0x00 0x00 0x00 0x70 0x04>;
			status = "disabled";
		};

		pcie@3500000 {
			compatible = "fsl,ls1088a-pcie\0snps,dw-pcie";
			reg = <0x00 0x3500000 0x00 0x100000 0x28 0x00 0x00 0x2000>;
			reg-names = "regs\0config";
			interrupts = <0x00 0x71 0x04>;
			interrupt-names = "aer";
			#address-cells = <0x03>;
			#size-cells = <0x02>;
			device_type = "pci";
			dma-coherent;
			num-lanes = <0x04>;
			bus-range = <0x00 0xff>;
			ranges = <0x81000000 0x00 0x00 0x28 0x10000 0x00 0x10000 0x82000000 0x00 0x40000000 0x28 0x40000000 0x00 0x40000000>;
			msi-parent = <0x12>;
			iommu-map = <0x00 0x13 0x00 0x01>;
			#interrupt-cells = <0x01>;
			interrupt-map-mask = <0x00 0x00 0x00 0x07>;
			interrupt-map = <0x00 0x00 0x00 0x01 0x01 0x00 0x00 0x00 0x72 0x04 0x00 0x00 0x00 0x02 0x01 0x00 0x00 0x00 0x73 0x04 0x00 0x00 0x00 0x03 0x01 0x00 0x00 0x00 0x74 0x04 0x00 0x00 0x00 0x04 0x01 0x00 0x00 0x00 0x75 0x04>;
			status = "disabled";
		};

		pcie@3600000 {
			compatible = "fsl,ls1088a-pcie\0snps,dw-pcie";
			reg = <0x00 0x3600000 0x00 0x100000 0x30 0x00 0x00 0x2000>;
			reg-names = "regs\0config";
			interrupts = <0x00 0x76 0x04>;
			interrupt-names = "aer";
			#address-cells = <0x03>;
			#size-cells = <0x02>;
			device_type = "pci";
			dma-coherent;
			num-lanes = <0x08>;
			bus-range = <0x00 0xff>;
			ranges = <0x81000000 0x00 0x00 0x30 0x10000 0x00 0x10000 0x82000000 0x00 0x40000000 0x30 0x40000000 0x00 0x40000000>;
			msi-parent = <0x12>;
			iommu-map = <0x00 0x13 0x00 0x01>;
			#interrupt-cells = <0x01>;
			interrupt-map-mask = <0x00 0x00 0x00 0x07>;
			interrupt-map = <0x00 0x00 0x00 0x01 0x01 0x00 0x00 0x00 0x77 0x04 0x00 0x00 0x00 0x02 0x01 0x00 0x00 0x00 0x78 0x04 0x00 0x00 0x00 0x03 0x01 0x00 0x00 0x00 0x79 0x04 0x00 0x00 0x00 0x04 0x01 0x00 0x00 0x00 0x7a 0x04>;
			status = "disabled";
		};

		wdt@c000000 {
			compatible = "arm,sp805-wdt\0arm,primecell";
			reg = <0x00 0xc000000 0x00 0x1000>;
			clocks = <0x02 0x04 0x01 0x02 0x04 0x01>;
			clock-names = "apb_pclk\0wdog_clk";
		};

		wdt@c010000 {
			compatible = "arm,sp805-wdt\0arm,primecell";
			reg = <0x00 0xc010000 0x00 0x1000>;
			clocks = <0x02 0x04 0x01 0x02 0x04 0x01>;
			clock-names = "apb_pclk\0wdog_clk";
		};

		wdt@c020000 {
			compatible = "arm,sp805-wdt\0arm,primecell";
			reg = <0x00 0xc020000 0x00 0x1000>;
			clocks = <0x02 0x04 0x01 0x02 0x04 0x01>;
			clock-names = "apb_pclk\0wdog_clk";
		};

		wdt@c030000 {
			compatible = "arm,sp805-wdt\0arm,primecell";
			reg = <0x00 0xc030000 0x00 0x1000>;
			clocks = <0x02 0x04 0x01 0x02 0x04 0x01>;
			clock-names = "apb_pclk\0wdog_clk";
		};

		wdt@c100000 {
			compatible = "arm,sp805-wdt\0arm,primecell";
			reg = <0x00 0xc100000 0x00 0x1000>;
			clocks = <0x02 0x04 0x01 0x02 0x04 0x01>;
			clock-names = "apb_pclk\0wdog_clk";
		};

		wdt@c110000 {
			compatible = "arm,sp805-wdt\0arm,primecell";
			reg = <0x00 0xc110000 0x00 0x1000>;
			clocks = <0x02 0x04 0x01 0x02 0x04 0x01>;
			clock-names = "apb_pclk\0wdog_clk";
		};

		wdt@c120000 {
			compatible = "arm,sp805-wdt\0arm,primecell";
			reg = <0x00 0xc120000 0x00 0x1000>;
			clocks = <0x02 0x04 0x01 0x02 0x04 0x01>;
			clock-names = "apb_pclk\0wdog_clk";
		};

		wdt@c130000 {
			compatible = "arm,sp805-wdt\0arm,primecell";
			reg = <0x00 0xc130000 0x00 0x1000>;
			clocks = <0x02 0x04 0x01 0x02 0x04 0x01>;
			clock-names = "apb_pclk\0wdog_clk";
		};

		pcs_mdio3: mdio@8c0f000 {
                        compatible = "fsl,fman-memac-mdio";
                        reg = <0x0 0x8c0f000 0x0 0x1000>;
                        little-endian;
                        #address-cells = <0x01>;
                        #size-cells = <0x00>;
                        status = "okay";

                        pcs3_0: ethernet-phy@0 {
                                reg = <0x00>;
                        };

                        pcs3_1: ethernet-phy@1 {
                                reg = <0x01>;
                        };

                        pcs3_2: ethernet-phy@2 {
                                reg = <0x02>;
                        };

                        pcs3_3: ethernet-phy@3 {
                                reg = <0x03>;
                        };
		};

                pcs_mdio7: mdio@8c1f000 {
                        compatible = "fsl,fman-memac-mdio";
                        reg = <0x0 0x8c1f000 0x0 0x1000>;
                        little-endian;
                        #address-cells = <0x01>;
                        #size-cells = <0x00>;
                        status = "okay";

                        pcs7_0: ethernet-phy@0 {
                                reg = <0x00>;
                        };

                        pcs7_1: ethernet-phy@1 {
                                reg = <0x01>;
                        };

                        pcs7_2: ethernet-phy@2 {
                                reg = <0x02>;
                        };

                        pcs7_3: ethernet-phy@3 {
                                reg = <0x03>;
                        };
                };

		fsl-mc@80c000000 {
			compatible = "fsl,qoriq-mc";
			reg = <0x08 0xc000000 0x00 0x40 0x00 0x8340000 0x00 0x40000>;
			msi-parent = <0x12>;
			iommu-map = <0x00 0x13 0x00 0x00>;
			dma-coherent;
			#address-cells = <0x03>;
			#size-cells = <0x01>;
			ranges = <0x00 0x00 0x00 0x08 0xc000000 0x4000000 0x01 0x00 0x00 0x08 0x18000000 0x8000000>;

			dpmacs {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				/*dpmac@1 {
					compatible = "fsl,qoriq-mc-dpmac";
					reg = <0x01>;
					phy-connection-type = "sgmii";
				};*/

				dpmac@2 {
					compatible = "fsl,qoriq-mc-dpmac";
					reg = <0x02>;
					phy-connection-type = "xgmii";
				};

				dpmac@3 {
					compatible = "fsl,qoriq-mc-dpmac";
					reg = <0x03>;
					phy-handle = <&mdio1_phy8>;
					phy-connection-type = "qsgmii";
					managed = "in-band-status";
					pcs-handle = <&pcs3_0>;
				};

				dpmac@4 {
					compatible = "fsl,qoriq-mc-dpmac";
					reg = <0x04>;
					phy-handle = <&mdio1_phy9>;
					phy-connection-type = "qsgmii";
					managed = "in-band-status";
					pcs-handle = <&pcs3_1>;
				};

				dpmac@5 {
					compatible = "fsl,qoriq-mc-dpmac";
					reg = <0x05>;
					phy-handle = <&mdio1_phy10>;
					phy-connection-type = "qsgmii";
					managed = "in-band-status";
					pcs-handle = <&pcs3_2>;
				};

				dpmac@6 {
					compatible = "fsl,qoriq-mc-dpmac";
					reg = <0x06>;
					phy-handle = <&mdio1_phy11>;
					phy-connection-type = "qsgmii";
					managed = "in-band-status";
					pcs-handle = <&pcs3_3>;
				};

				dpmac@7 {
					compatible = "fsl,qoriq-mc-dpmac";
					reg = <0x07>;
					phy-handle = <&mdio1_phy4>;
					phy-connection-type = "qsgmii";
					managed = "in-band-status";
					pcs-handle = <&pcs7_0>;
				};

				dpmac@8 {
					compatible = "fsl,qoriq-mc-dpmac";
					reg = <0x08>;
					phy-handle = <&mdio1_phy5>;
					phy-connection-type = "qsgmii";
					managed = "in-band-status";
					pcs-handle = <&pcs7_1>;
				};

				dpmac@9 {
					compatible = "fsl,qoriq-mc-dpmac";
					reg = <0x09>;
					phy-handle = <&mdio1_phy6>;
					phy-connection-type = "qsgmii";
					managed = "in-band-status";
					pcs-handle = <&pcs7_2>;
				};

				dpmac@10 {
					compatible = "fsl,qoriq-mc-dpmac";
					reg = <0x0a>;
					phy-handle = <&mdio1_phy7>;
					phy-connection-type = "qsgmii";
					managed = "in-band-status";
					pcs-handle = <&pcs7_3>;
				};
			};
		};

		iommu@5000000 {
			compatible = "arm,mmu-500";
			reg = <0x00 0x5000000 0x00 0x800000>;
			#global-interrupts = <0x0c>;
			#iommu-cells = <0x01>;
			stream-match-mask = <0x7c00>;
			dma-coherent;
			interrupts = <0x00 0x0d 0x04 0x00 0x0e 0x04 0x00 0x0f 0x04 0x00 0x10 0x04 0x00 0xd3 0x04 0x00 0xd4 0x04 0x00 0xd5 0x04 0x00 0xd6 0x04 0x00 0xd7 0x04 0x00 0xd8 0x04 0x00 0xd9 0x04 0x00 0xda 0x04 0x00 0x92 0x04 0x00 0x93 0x04 0x00 0x94 0x04 0x00 0x95 0x04 0x00 0x96 0x04 0x00 0x97 0x04 0x00 0x98 0x04 0x00 0x99 0x04 0x00 0x9a 0x04 0x00 0x9b 0x04 0x00 0x9c 0x04 0x00 0x9d 0x04 0x00 0x9e 0x04 0x00 0x9f 0x04 0x00 0xa0 0x04 0x00 0xa1 0x04 0x00 0xa2 0x04 0x00 0xa3 0x04 0x00 0xa4 0x04 0x00 0xa5 0x04 0x00 0xa6 0x04 0x00 0xa7 0x04 0x00 0xa8 0x04 0x00 0xa9 0x04 0x00 0xaa 0x04 0x00 0xab 0x04 0x00 0xac 0x04 0x00 0xad 0x04 0x00 0xae 0x04 0x00 0xaf 0x04 0x00 0xb0 0x04 0x00 0xb1 0x04 0x00 0xb2 0x04 0x00 0xb3 0x04 0x00 0xb4 0x04 0x00 0xb5 0x04 0x00 0xb6 0x04 0x00 0xb7 0x04 0x00 0xb8 0x04 0x00 0xb9 0x04 0x00 0xba 0x04 0x00 0xbb 0x04 0x00 0xbc 0x04 0x00 0xbd 0x04 0x00 0xbe 0x04 0x00 0xbf 0x04 0x00 0xc0 0x04 0x00 0xc1 0x04 0x00 0xc2 0x04 0x00 0xc3 0x04 0x00 0xc4 0x04 0x00 0xc5 0x04 0x00 0xc6 0x04 0x00 0xc7 0x04 0x00 0xc8 0x04 0x00 0xc9 0x04 0x00 0xca 0x04 0x00 0xcb 0x04 0x00 0xcc 0x04 0x00 0xcd 0x04 0x00 0xce 0x04 0x00 0xcf 0x04 0x00 0xd0 0x04 0x00 0xd1 0x04>;
			phandle = <0x13>;
		};
	};

	firmware {

		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
		};
	};

	leds {
		compatible = "gpio-leds";

		mcu_boot0 {
			label = "mcu-boot0";
			gpios = <&pca9555 8 0x00>;
			default-state = "off";
		};

		mcu_nrst {
			label = "mcu-nrst";
			gpios = <&pca9555 9 0x00>;
			default-state = "on";
		};

		adcen_bat {
			label = "adcen-bat";
			gpios = <&pca9555 10 0x00>;
			default-state = "off";
		};

		adcen_edlc {
			label = "adcen-edlc";
			gpios = <&pca9555 11 0x00>;
			default-state = "off";
		};
	};

	chosen {
		stdout-path = "serial1:115200n8";
	};
};
