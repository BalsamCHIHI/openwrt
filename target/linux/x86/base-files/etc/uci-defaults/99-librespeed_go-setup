STATE_FILE="/etc/uci-defaults.state"
SCRIPT_NAME="99-librespeed_go-setup"

# Check if this script's name is already in the state file
if grep -qx "$SCRIPT_NAME" "$STATE_FILE" 2>/dev/null; then
	echo "librespeed-go_setup : librespeed-go setup skipped (already configured)." > /dev/kmsg
	exit 0
fi

echo "librespeed-go_setup : librespeed-go setup started." > /dev/kmsg

uci set librespeed-go.config.enabled='1'           # Enable the daemon in UCI
uci set librespeed-go.config.bind_address=''       # bind all interfaces
uci set librespeed-go.config.listen_port='8989'    # or pick another free port
uci set librespeed-go.config.database_type='none'  # no telemetry (lightest)

uci commit librespeed-go
reload_config

# Append the script name to the state file so it never runs again
echo "$SCRIPT_NAME" >> "$STATE_FILE"

echo "librespeed-go_setup : librespeed-go setup completed." > /dev/kmsg

exit 0
