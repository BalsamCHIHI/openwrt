STATE_FILE="/etc/uci-defaults.state"
SCRIPT_NAME="93-wireless-setup"

# Check if this script's name is already in the state file
if grep -qx "$SCRIPT_NAME" "$STATE_FILE" 2>/dev/null; then
	echo "wireless_setup : Wi-Fi setup skipped (already configured)." > /dev/kmsg
	exit 0
fi

if [ -f /sys/class/net/wan/address ]; then
    mac_suffix=$(awk -F: '{print $4$5$6}' /sys/class/net/wan/address 2>/dev/null)
else
    mac_suffix=''
fi

[ -z "$mac_suffix" ] && {
    echo "wireless_setup : mac_suffix variable not found, Wi-Fi setup failed." > /dev/kmsg
    exit 1
}

echo "wireless_setup : Wi-Fi setup started." > /dev/kmsg

# OpenWrt-v25.12.5 related change:
# The ath12k QCN9274 chips take several seconds to boot firmware over PCIe.
# Passively wait for OpenWrt's background ieee80211 hotplug event to generate 
# the base PCI paths of the radios so we don't collide with it or overwrite incomplete configs.
echo "wireless_setup : Waiting for OpenWrt background hotplug to initialize Wi-Fi hardware..." > /dev/kmsg

hardware_ready=0
for i in $(seq 1 30); do
	# Passively check if the background event has finished writing the paths
	if uci -q get wireless.radio0.path >/dev/null && \
	   uci -q get wireless.radio1.path >/dev/null && \
	   uci -q get wireless.radio2.path >/dev/null; then
		hardware_ready=1
		echo "wireless_setup : All 3 Wi-Fi PHYs fully detected after $i seconds." > /dev/kmsg
		break
	fi
	sleep 1
done

if [ "$hardware_ready" -eq 0 ]; then
	echo "wireless_setup : Timeout waiting for Wi-Fi hardware. Wi-Fi setup failed." > /dev/kmsg
    exit 1
fi

# Wipe the randomly generated hotplug config to build a clean, deterministic one
rm -f /etc/config/wireless
touch /etc/config/wireless

# ==========================================
# radio 0 (Integrated Kiwi - 2.4 GHz)
# ==========================================
uci set wireless.radio0=wifi-device
uci set wireless.radio0.type='mac80211'
uci set wireless.radio0.path='soc@0/18000000.pcie/pci0003:00/0003:00:00.0/0003:01:00.0'
uci set wireless.radio0.radio='0'
uci set wireless.radio0.band='2g'
uci set wireless.radio0.channel='1'
uci set wireless.radio0.htmode='EHT20'
uci set wireless.radio0.country='FR'
uci set wireless.radio0.cell_density='0'
uci set wireless.radio0.short_preamble='1'
uci set wireless.radio0.noscan='1'
uci set wireless.radio0.disabled='0'

# ap 0
uci set wireless.default_radio0=wifi-iface
uci set wireless.default_radio0.device='radio0'
uci set wireless.default_radio0.mode='ap'
uci set wireless.default_radio0.ssid="Kiwi_DVK-${mac_suffix}-2.4GHz"
uci set wireless.default_radio0.encryption='none'
uci set wireless.default_radio0.isolate='0'
uci set wireless.default_radio0.disassoc_low_ack='1'
uci set wireless.default_radio0.multicast_to_unicast_all='1'
uci set wireless.default_radio0.ieee80211k='1'
uci set wireless.default_radio0.bss_transition='1'
uci set wireless.default_radio0.network='wlan'
uci set wireless.default_radio0.disabled='0'

# ==========================================
# radio 1 (Integrated Kiwi - 6 GHz)
# ==========================================
uci set wireless.radio1=wifi-device
uci set wireless.radio1.type='mac80211'
uci set wireless.radio1.path='soc@0/18000000.pcie/pci0003:00/0003:00:00.0/0003:01:00.0'
uci set wireless.radio1.radio='1'
uci set wireless.radio1.band='6g'
uci set wireless.radio1.channel='1'
uci set wireless.radio1.htmode='EHT20'
uci set wireless.radio1.country='FR'
uci set wireless.radio1.cell_density='0'
uci set wireless.radio1.short_preamble='1'
uci set wireless.radio1.noscan='1'
uci set wireless.radio1.disabled='0'

# ap 0
uci set wireless.default_radio1=wifi-iface
uci set wireless.default_radio1.device='radio1'
uci set wireless.default_radio1.mode='ap'
uci set wireless.default_radio1.ssid="Kiwi_DVK-${mac_suffix}-6GHz"
uci set wireless.default_radio1.encryption='sae'	# Mandatory for 6GHz
uci set wireless.default_radio1.key='00000000'
uci set wireless.default_radio1.ieee80211w='2'		# Mandatory for SAE
uci set wireless.default_radio1.ocv='1'
uci set wireless.default_radio1.isolate='0'
uci set wireless.default_radio1.disassoc_low_ack='1'
uci set wireless.default_radio1.multicast_to_unicast_all='1'
uci set wireless.default_radio1.ieee80211k='1'
uci set wireless.default_radio1.bss_transition='1'
uci set wireless.default_radio1.network='wlan'
uci set wireless.default_radio1.disabled='0'

# ==========================================
# radio 2 (Noni Module - 5 GHz)
# ==========================================
uci set wireless.radio2=wifi-device
uci set wireless.radio2.type='mac80211'
uci set wireless.radio2.path='soc@0/20000000.pcie/pci0002:00/0002:00:00.0/0002:01:00.0'
uci set wireless.radio2.band='5g'
uci set wireless.radio2.channel='36'
uci set wireless.radio2.htmode='EHT20'
uci set wireless.radio2.country='FR'
uci set wireless.radio2.cell_density='0'
uci set wireless.radio2.short_preamble='1'
uci set wireless.radio2.noscan='1'
uci set wireless.radio2.disabled='0'

# ap 0
uci set wireless.default_radio2=wifi-iface
uci set wireless.default_radio2.device='radio2'
uci set wireless.default_radio2.mode='ap'
uci set wireless.default_radio2.ssid="Kiwi_DVK-Noni-${mac_suffix}-5GHz"
uci set wireless.default_radio2.encryption='none'
uci set wireless.default_radio2.isolate='0'
uci set wireless.default_radio2.disassoc_low_ack='1'
uci set wireless.default_radio2.multicast_to_unicast_all='1'
uci set wireless.default_radio2.ieee80211k='1'
uci set wireless.default_radio2.bss_transition='1'
uci set wireless.default_radio2.network='wlan'
uci set wireless.default_radio2.disabled='0'

# Save and apply the locked configuration
uci commit wireless
wifi reload
reload_config

# Append the script name to the state file so it never runs again
echo "$SCRIPT_NAME" >> "$STATE_FILE"

echo "wireless_setup : Wi-Fi setup completed deterministically." > /dev/kmsg

exit 0
