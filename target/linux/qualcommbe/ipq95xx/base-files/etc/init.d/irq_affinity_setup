#!/bin/sh /etc/rc.common

START=99

boot() {
    echo "irq-affinity : Starting background wait for Wi-Fi PCIe enumeration..." > /dev/kmsg

    (
        # Passively wait up to 60 seconds for ath12k MSI-X vectors to appear
        for i in $(seq 1 60); do
            if grep -q "DP_EXT_IRQ" /proc/interrupts; then
                sleep 3 # Give the driver 3 seconds to finish mapping all vectors

                # 1. Pin Integrated Kiwi Radios (6 GHz + 2.4 GHz) to CPU 1
                for irq in $(awk '/0003:01:00.0/ && /DP_EXT_IRQ/ {sub(":","",$1); print $1}' /proc/interrupts); do
                    echo 1 > /proc/irq/$irq/smp_affinity_list
                done

                # 2. Pin Noni Radio (5 GHz) to CPU 2
                for irq in $(awk '/0002:01:00.0/ && /DP_EXT_IRQ/ {sub(":","",$1); print $1}' /proc/interrupts); do
                    echo 2 > /proc/irq/$irq/smp_affinity_list
                done

                # 3. Pin Ethernet EDMA Queues (rxdesc / txcmpl) to CPU 3
                for pfx in rxdesc txcmpl; do
                    for irq in $(awk -v p="$pfx" '$NF ~ "^"p"_" {sub(":","",$1); print $1}' /proc/interrupts); do
                        echo 3 > /proc/irq/$irq/smp_affinity_list
                    done
                done

                echo "irq-affinity : Successfully pinned Wi-Fi and EDMA interrupts to cores 1, 2, and 3." > /dev/kmsg
                break
            fi
            sleep 1
        done
    ) &
}
