#!/bin/sh /etc/rc.common

START=99

boot() {
    if [ -f "/tmp/first_boot_flag" ]; then
        echo "<4>======================================================" > /dev/kmsg
        echo "<4>SYSTEM Warning: First boot sequence complete." > /dev/kmsg
        echo "<4>Please reboot to apply all changes." > /dev/kmsg
        echo "<4>======================================================" > /dev/kmsg
    else
        echo "<5>======================================================" > /dev/kmsg
        echo "<5>SYSTEM Notice: Normal boot sequence complete." > /dev/kmsg
        echo "<5>======================================================" > /dev/kmsg
    fi

    return 0
}
