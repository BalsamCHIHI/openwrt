+restool_error_workaround() {
+	needed=0
+	test=$($restool -v  | cut -d" " -f2)
+	if [ -z $test ]; then
+		needed=1
+		echo "### Workaround for restool error with multiple dpni. Ignore error messages below"
+	fi
+	#echo "test=_ $test _"
+	while [ -z $test ]; do
+		#       echo "toto"
+		#       test=$($restool -v)
+		test=$($restool -v  | cut -d" " -f2 2>/dev/null)
+	done
+	if [ $needed = 1 ]; then
+		echo "### End of Workaround"
+	fi
+}
