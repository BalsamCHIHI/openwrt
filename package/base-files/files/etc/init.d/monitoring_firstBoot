#!/bin/sh /etc/rc.common

START=80

start() {
    # Find the MTD partition with the name "monitor"
    MONITOR_MTD=$(grep '"monitor"' /proc/mtd | awk -F: '{print $1}')

    if [ -z "$MONITOR_MTD" ]; then
        echo "Error: MTD partition with name 'monitor' not found."
        exit 1
    fi

    # Format the partition name for mounting
    MONITOR_MTD_BLOCK=$(echo $MONITOR_MTD | sed 's/mtd/mtdblock/')

    if [ ! -d "/mnt/monitor" ]; then
        echo "Erasing /dev/$MONITOR_MTD..."
        flash_erase -j /dev/$MONITOR_MTD 0 0
        mkdir -p /mnt/monitor
        echo "Mounting /dev/$MONITOR_MTD_BLOCK..."
        mount -t jffs2 /dev/$MONITOR_MTD_BLOCK /mnt/monitor
    else
        echo "/dev/$MONITOR_MTD_BLOCK is already mounted."
    fi
}
