+u8 get_pll_status(void) {
+        struct ccsr_serdes __iomem *serdes1_base = (void *)CONFIG_SYS_FSL_LSCH3_SERDES_ADDR;
+        struct ccsr_serdes __iomem *serdes2_base = (void *)(CONFIG_SYS_FSL_LSCH3_SERDES_ADDR + 0x10000);
