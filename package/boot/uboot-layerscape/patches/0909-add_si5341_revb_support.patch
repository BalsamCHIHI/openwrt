+        u8 pll_status = 0;
+
+        for (int serdes=0; serdes<2; serdes++) {
+                struct ccsr_serdes __iomem *serdes_base = (serdes==0) ? serdes1_base : serdes2_base;
+                for (int pll=0; pll<2; pll++) {
+                        uint32_t status = serdes_base->bank[pll].rstctl;
+                        if ((status&(1<<29)) == 0)
