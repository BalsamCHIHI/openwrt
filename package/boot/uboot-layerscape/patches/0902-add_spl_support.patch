+static int __gpio_idx_by_name(const char *name)
+{
+	int i;
+
+	if((name == NULL) || (strlen(name) <= 0)) {
+		return -1;
+	}
+
+	for(i=0; i<sizeof(tqc_moment_connect_i2c_gpios)/sizeof(tqc_moment_connect_i2c_gpios[0]); i++) {
+		if((strlen(tqc_moment_connect_i2c_gpios[i].name) == strlen(name)) &&
+			(strncmp(tqc_moment_connect_i2c_gpios[i].name, name, strlen(name)) == 0)) {
+			return i;
+		}
+	}
+
+	return -1;
+}
+
+
+
+int tqc_moment_connect_i2c_gpios_init(void)
+{
+	int ret = 0;
+	unsigned int oldbus;
+	int i;
+	char *env;
+	uint8_t val;
+
+	oldbus = i2c_get_bus_num();
+	i2c_set_bus_num(PCA953X_I2C_GPIO_BUS_NUM);
+
+	for(i=0; i<sizeof(tqc_moment_connect_i2c_gpios)/sizeof(tqc_moment_connect_i2c_gpios[0]); i++) {
+		if(tqc_moment_connect_i2c_gpios[i].dir == PCA953X_DIR_OUT) {
+			pca953x_set_val(tqc_moment_connect_i2c_gpios[i].addr,
+				1 << tqc_moment_connect_i2c_gpios[i].nr,
+				tqc_moment_connect_i2c_gpios[i].dval << tqc_moment_connect_i2c_gpios[i].nr);
+		}
+		pca953x_set_dir(tqc_moment_connect_i2c_gpios[i].addr,
+			1 << tqc_moment_connect_i2c_gpios[i].nr,
+			tqc_moment_connect_i2c_gpios[i].dir << tqc_moment_connect_i2c_gpios[i].nr);
+	}
+
+	// Reset PHY after power-up
+	printf("### Reset PHYs\n");
+	tqc_moment_connect_i2c_gpio_set("mrst1", 0);
+	tqc_moment_connect_i2c_gpio_set("mrst2", 0);
+	mdelay(10);
+
+	env = env_get("mrst1");
+	if (env && (strcmp(env, "0")==0))
+		val = 0;
+	else
+		val = 1;
+	tqc_moment_connect_i2c_gpio_set("mrst1", val);
+	
+	env = env_get("mrst2");
+	if (env && (strcmp(env, "0")==0))
+		val = 0;
+	else
+		val = 1;
+	tqc_moment_connect_i2c_gpio_set("mrst2", val);
+	
+	mdelay(200);
+
+	i2c_set_bus_num(oldbus);
+
+	return ret;
+}
+
+int tqc_moment_connect_i2c_gpio_get(const char *name)
+{
+	int ret = -1;
+	unsigned int oldbus;
+	int idx, val;
+
+	idx = __gpio_idx_by_name(name);
+	if(idx < 0)
+		return -1;
+
+	oldbus = i2c_get_bus_num();
+	i2c_set_bus_num(PCA953X_I2C_GPIO_BUS_NUM);
+
+	if(tqc_moment_connect_i2c_gpios[idx].dir == PCA953X_DIR_IN) {
+		val = pca953x_get_val(tqc_moment_connect_i2c_gpios[idx].addr);
+		if(val >= 0) {
+			ret = (val & (1 << tqc_moment_connect_i2c_gpios[idx].nr))?(1):(0);
+		}
+	}
+
+	i2c_set_bus_num(oldbus);
+	return ret;
+}
+
+int tqc_moment_connect_i2c_gpio_set(const char *name, int val)
+{
+	int ret = -1;
+	unsigned int oldbus;
+	int idx;
+
+	idx = __gpio_idx_by_name(name);
+	if(idx < 0)
+		return -1;
+
+	oldbus = i2c_get_bus_num();
+	i2c_set_bus_num(PCA953X_I2C_GPIO_BUS_NUM);
+
+	if(tqc_moment_connect_i2c_gpios[idx].dir != PCA953X_DIR_OUT)
+		return -1;
+
+	if(!val)
+		ret = pca953x_set_val(
+				tqc_moment_connect_i2c_gpios[idx].addr,
+				1 << tqc_moment_connect_i2c_gpios[idx].nr,
+				0);
+	else
+		ret = pca953x_set_val(
+				tqc_moment_connect_i2c_gpios[idx].addr,
+				1 << tqc_moment_connect_i2c_gpios[idx].nr,
+				1 <<  tqc_moment_connect_i2c_gpios[idx].nr);
+
+	i2c_set_bus_num(oldbus);
+	return ret;
+}
+
+
+static int clkgen_reg_write(uint16_t reg, uint8_t val) {
+	int ret = 0;
+	uint8_t page = reg >> 8;
+
+	if (page != clkgen_current_page) {
+		clkgen_current_page = page;
+		ret = i2c_write(clkgen_addr, 0x0001, 1, &page, 1);
+		if (ret) return ret;
+	}
+
+	ret = i2c_write(clkgen_addr, reg & 0xFF, 1, &val, 1);
+	return ret;
+}
+
+static int clkgen_reg_read(uint16_t reg, uint8_t * val) {
+	int ret = 0;
+	uint8_t page = reg >> 8;
+
+	if (page != clkgen_current_page) {
+		clkgen_current_page = page;
+		ret = i2c_write(clkgen_addr, 0x0001, 1, &page, 1);
+		if (ret) return ret;
+	}
+
+	ret = i2c_read(clkgen_addr, reg & 0xFF, 1, val, 1);
+
+	return ret;
+}
+
+int tqc_moment_connect_clk_cfg_init(void)
+{
+	int ret = 0;
+	unsigned int oldbus;
+	//uint8_t buf[4];
+	//int i;
+	si5341_revd_register_t * si5341_registers;
+	int si5341_registers_nb;
+	uint8_t preamble_size;
+	uint8_t val;
+
+	oldbus = i2c_get_bus_num();
+	
+	// Scan I2CV busses to detect clock generator
+	printf("Scan I2C busses :\n");
+	//i2c_disable_log();
+	for (unsigned int bus=0; bus<4; bus++) {
+		uint8_t found = 0;
+		i2c_set_bus_num(bus);
+
+		for (unsigned int chip=1; chip<128; chip++) {
+			if (i2c_probe(chip) == 0) {
+				printf("\tfound %d:%.02x\n", bus, chip);
+				found = 1;
+				if ((chip == SI5341B_REVA_CLKBUF_ADDR) || (chip == SI5341B_REVD_CLKBUF_ADDR))
+					clkgen_addr = chip;
+			}
+		}
+
+		if (found == 0)
+			printf("\tfound nothing on bus %d\n", bus);
+	}
+	printf("clkgen_addr=%.02x\n", clkgen_addr);
+	//i2c_enable_log();
+
+	if (clkgen_addr == SI5341B_REVA_CLKBUF_ADDR) {
+		si5341_registers = (si5341_revd_register_t*)&si5341_reva_registers;
+		si5341_registers_nb = SI5341_REVA_REG_CONFIG_NUM_REGS;
+		preamble_size = 2;
+		
+	} else if (clkgen_addr == SI5341B_REVD_CLKBUF_ADDR) {
+		si5341_registers = (si5341_revd_register_t*)&si5341_revd_registers;
+		si5341_registers_nb = SI5341_REVD_REG_CONFIG_NUM_REGS;
+		preamble_size = 6;
+	} else {
+		goto ERROR;
+	}
+
+	i2c_set_bus_num(SI5341B_CLKBUF_BUS_NUM);
+
+#if 0
+	ret = i2c_read(TQC_MOMENT_CONNECT_I2C_CLKBUF_ADDR, 0x02, 1, buf, 2);
+	if(ret != 0)
+		printf("Clock buffer unreachable\n");
+	else
+		printf("Clock whoami : %.02x%.02x\n", buf[1], buf[0]); // 7f92 !
+	
+	ret = i2c_read(TQC_MOMENT_CONNECT_I2C_CLKBUF_ADDR, 0x0b, 1, buf, 1);
+	if(ret != 0)
+		printf("Clock buffer unreachable\n");
+	else
+		printf("I2C address : %.02x\n", buf[0]);
+	
+	ret = i2c_read(TQC_MOMENT_CONNECT_I2C_CLKBUF_ADDR, 0xe2, 1, buf, 1);
+	if(ret != 0)
+		printf("Clock buffer unreachable\n");
+	else
+		printf("Active NVM bank : %.02x\n", buf[0]);
+#endif
+
+	// Check if clocks already reconfigured
+	// read IN_SEL (IN_SEL_REGCTRL)
+	// Must be 0x07
+	ret = clkgen_reg_read(0x0021, &val);
+	if (ret) goto ERROR;
+	
+	if ((val & 0x7) == 0x7) {
+		// Already configured
+		goto SUCCESS;
+	}
+
+	// Dynamic PLL change (needed preamble)
+	if (clkgen_addr == SI5341B_REVA_CLKBUF_ADDR) {
+		ret = clkgen_reg_write(0x0B24, 0xD8);
+		if (ret) goto ERROR;
+		ret = clkgen_reg_write(0x0B25, 0x00);
+		if (ret) goto ERROR;
+	} else {
+		ret = clkgen_reg_write(0x0B24, 0xC0);
+		if (ret) goto ERROR;
+		ret = clkgen_reg_write(0x0B25, 0x00);
+		if (ret) goto ERROR;
+	}
+	ret = clkgen_reg_write(0x0502, 0x01);
+	if (ret) goto ERROR;
+	ret = clkgen_reg_write(0x0505, 0x03);
+	if (ret) goto ERROR;
+	ret = clkgen_reg_write(0x0957, 0x17);
+	if (ret) goto ERROR;
+	ret = clkgen_reg_write(0x0B4E, 0x1A);
+	if (ret) goto ERROR;
+	mdelay(300);
+
+	// Set registers (on revision A, pre and post-ambles are different from revision D)
+	for (int i=preamble_size; i<si5341_registers_nb; i++) {
+		// Do not change I2C address
+		if (si5341_registers[i].address == 0x000B)
+			continue;
+
+		ret = clkgen_reg_write(si5341_registers[i].address, si5341_registers[i].value);
+		if (ret)
+			goto ERROR;
+	}
+	
+	// mPCIe Wifi detection workaround
+	//if (ret == 0) goto SUCCESS;
+	do_reset(NULL, 0, 0, NULL);
+
+ERROR:
+	printf("Communication failure with clock generator\n");
+
+SUCCESS:
+	i2c_set_bus_num(oldbus);
+	return ret;
+}
+
+void tqc_moment_connect_xfi_init(struct ccsr_serdes *serdes, int lane)
+{
+	u32 gcr0, rec0;;
+
+	//printf("## Press 's' to skip XFI reconfiguration\n");
+	//if (getc() == 's')
+	//	return;
+
+	/* Put lane in reset */
+	gcr0 = serdes_in32(&serdes->lane[lane].gcr0);
+	gcr0 &= 0xFF9FFFFF;
+	serdes_out32(&serdes->lane[lane].gcr0, gcr0);
+
+	udelay(1);
+
+	/* Set up Transmit Equalization Control Register 0 for XFI */
+	printf("  Enabled\n");
+	serdes_out32(&serdes->lane[lane].tec0,  0x24ec2000);
+
+	/* Disable Rx Equalization Boost */
+	/*
+	rec0 = serdes_in32(&serdes->lane[lane].rec0);
+	rec0 &= ~(1<<28);
+	serdes_out32(&serdes->lane[lane].rec0, rec0);
+	*/
+
+	udelay(1);
+
+	/* Take lane out of reset */
+	gcr0 |= 0x00600000;
+	serdes_out32(&serdes->lane[lane].gcr0, gcr0);
+}
+
+void tqc_moment_connect_lane_disable(struct ccsr_serdes *serdes, int lane)
+{
+	u32 gcr0;
+
+	/* Put lane in reset */
+	gcr0 = serdes_in32(&serdes->lane[lane].gcr0);
+	gcr0 &= 0xFF9FFFFF;
+	gcr0 |= 0x00180000;
+	serdes_out32(&serdes->lane[lane].gcr0, gcr0);
+
+	udelay(1);
+}
+
+
+#ifndef CONFIG_SPL_BUILD
+static char *_srds_proto_name(int proto)
+{
+	switch(proto) {
+	case TQC_MOMENT_CONNECT_SRDS_PROTO_UNUSED:
+		return "Unused    ";
+	case TQC_MOMENT_CONNECT_SRDS_PROTO_SGMII:
+		return "SGMII     ";
+	case TQC_MOMENT_CONNECT_SRDS_PROTO_SGMII2G5:
+		return "2.5G SGMII";
+	case TQC_MOMENT_CONNECT_SRDS_PROTO_QSGMII:
+		return "QSGMII    ";
+	case TQC_MOMENT_CONNECT_SRDS_PROTO_XFI:
+		return "XFI       ";
+	case TQC_MOMENT_CONNECT_SRDS_PROTO_PCIEx1:
+		return "PCIe x1   ";
+	case TQC_MOMENT_CONNECT_SRDS_PROTO_PCIEx2:
+		return "PCIe x2   ";
+	case TQC_MOMENT_CONNECT_SRDS_PROTO_PCIEx4:
+		return "PCIe x4   ";
+	case TQC_MOMENT_CONNECT_SRDS_PROTO_SATA:
+		return "SATA      ";
+	default:
+		return "Unknown   ";
+	}
+}
+#endif
+
+static int _srds_mux_check_and_print(int port, int lane, int mux, int proto)
+{
+	int stat = 0;
+
+	if((proto != TQC_MOMENT_CONNECT_SRDS_PROTO_UNUSED) &&
+	   (proto != mux))
+		stat++;
+
+	printf("  SD%d-%d: MUX=%s | RCW=%s -> %s\n",
+	   port, lane, _srds_proto_name(mux), _srds_proto_name(proto),
+	   (stat)?("FAIL"):("OK"));
+
+	return stat;
+}
+
+int tqc_moment_connect_serdes_init(struct tqc_moment_connect_serdes lanes[8])
+{
+	int err_cnt = 0;
+
+	printf("Checking MOMENT_CONNECT SerDes muxing:\n");
+
+	/* check config for SD1_0 */
+	err_cnt += _srds_mux_check_and_print( lanes[0].port, lanes[0].lane, TQC_MOMENT_CONNECT_SRDS_PROTO_XFI, lanes[0].proto);
+
+	/* check config for SD1_1 */
+	err_cnt += _srds_mux_check_and_print( lanes[1].port, lanes[1].lane, TQC_MOMENT_CONNECT_SRDS_PROTO_SGMII, lanes[1].proto);
+
+	/* check config for SD1_2 */
+	err_cnt += _srds_mux_check_and_print( lanes[2].port, lanes[2].lane, TQC_MOMENT_CONNECT_SRDS_PROTO_QSGMII, lanes[2].proto);
+
+	/* check config for SD1_3 */
+	err_cnt += _srds_mux_check_and_print( lanes[3].port, lanes[3].lane, TQC_MOMENT_CONNECT_SRDS_PROTO_QSGMII, lanes[3].proto);
+
+	/* check config for SD2_0 */
+	err_cnt += _srds_mux_check_and_print( lanes[4].port, lanes[4].lane, TQC_MOMENT_CONNECT_SRDS_PROTO_PCIEx1, lanes[4].proto);
+
+	/* check config for SD2_1 */
+	err_cnt += _srds_mux_check_and_print( lanes[5].port, lanes[5].lane, TQC_MOMENT_CONNECT_SRDS_PROTO_PCIEx1, lanes[5].proto);
+
+	/* check config for SD2_2 */
+	err_cnt += _srds_mux_check_and_print( lanes[6].port, lanes[6].lane, TQC_MOMENT_CONNECT_SRDS_PROTO_PCIEx1, lanes[6].proto);
+
+	/* check config for SD2_3 */
+	err_cnt += _srds_mux_check_and_print( lanes[7].port, lanes[7].lane, TQC_MOMENT_CONNECT_SRDS_PROTO_SATA, lanes[7].proto);
+
+	/* print error message when muxing is invalid */
+	if(err_cnt) {
+		printf("!!! ATTENTION: Some SerDes lanes are misconfigured,\n");
+		printf("!!!  this may cause some interfaces to be inoperable.\n");
+		printf("!!!  Check SerDes muxing DIP switch settings!\n");
+	}
+
+	return 0;
+}
