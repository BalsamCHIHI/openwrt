+int tqc_bb_board_eth_init(struct bd_info *bis)
+{
+#ifdef CONFIG_FSL_MC_ENET
+	struct memac_mdio_info mdio_info;
+	struct mii_dev *dev_mdio;
+	struct ccsr_gur *gur = (void *)(CONFIG_SYS_FSL_GUTS_ADDR);
+	struct memac_mdio_controller *reg;
+	u32 srds_s1;
+
+	/* read SerDes configuration from RCW */
+	srds_s1 = in_le32(&gur->rcwsr[FSL_CHASSIS3_SRDS1_REGSR - 1]) &
+		FSL_CHASSIS3_SRDS1_PRTCL_MASK;
+	srds_s1 >>= FSL_CHASSIS3_SRDS1_PRTCL_SHIFT;
+
+	/* Register the EMI 1 */
+	reg = (struct memac_mdio_controller *)CONFIG_SYS_FSL_WRIOP1_MDIO1;
+	mdio_info.regs = reg;
+	mdio_info.name = DEFAULT_WRIOP_MDIO1_NAME;
+	fm_memac_mdio_init(bis, &mdio_info);
+
+	/* get MDIO bus devices */
+	dev_mdio = miiphy_get_dev_by_name(DEFAULT_WRIOP_MDIO1_NAME);
+
+	/* set xGMII PHY addresses based on RCW */
+	switch(TQMLS1088A_SRDS1_PROTO(srds_s1, 3)) {
+		case 0x3: // SGMII
+			wriop_set_phy_address(WRIOP1_DPMAC3, 0, QSGMII_PHY2_ADDR_BASE+0);
+			wriop_set_mdio(WRIOP1_DPMAC3, dev_mdio);
+			break;
+		case 0x4: // QSGMII
+			wriop_set_phy_address(WRIOP1_DPMAC3, 0, QSGMII_PHY2_ADDR_BASE+0);
+			wriop_set_mdio(WRIOP1_DPMAC3, dev_mdio);
+			wriop_set_phy_address(WRIOP1_DPMAC4, 0, QSGMII_PHY2_ADDR_BASE+1);
+			wriop_set_mdio(WRIOP1_DPMAC4, dev_mdio);
+			wriop_set_phy_address(WRIOP1_DPMAC5, 0, QSGMII_PHY2_ADDR_BASE+2);
+			wriop_set_mdio(WRIOP1_DPMAC5, dev_mdio);
+			wriop_set_phy_address(WRIOP1_DPMAC6, 0, QSGMII_PHY2_ADDR_BASE+3);
+			wriop_set_mdio(WRIOP1_DPMAC6, dev_mdio);
+			break;
+	}
+	
+	switch(TQMLS1088A_SRDS1_PROTO(srds_s1, 2)) {
+		case 0x3: // SGMII
+			wriop_set_phy_address(WRIOP1_DPMAC7, 0, QSGMII_PHY1_ADDR_BASE+0);
+			wriop_set_mdio(WRIOP1_DPMAC7, dev_mdio);
+			break;
+		case 0x4: // QSGMII
+			wriop_set_phy_address(WRIOP1_DPMAC7, 0, QSGMII_PHY1_ADDR_BASE+0);
+			wriop_set_mdio(WRIOP1_DPMAC7, dev_mdio);
+			wriop_set_phy_address(WRIOP1_DPMAC8, 0, QSGMII_PHY1_ADDR_BASE+1);
+			wriop_set_mdio(WRIOP1_DPMAC8, dev_mdio);
+			wriop_set_phy_address(WRIOP1_DPMAC9, 0, QSGMII_PHY1_ADDR_BASE+2);
+			wriop_set_mdio(WRIOP1_DPMAC9, dev_mdio);
+			wriop_set_phy_address(WRIOP1_DPMAC10, 0, QSGMII_PHY1_ADDR_BASE+3);
+			wriop_set_mdio(WRIOP1_DPMAC10, dev_mdio);
+			break;
+	}
+	
+	switch(TQMLS1088A_SRDS1_PROTO(srds_s1, 0)) {
+		case 0x1: // XFI
+			wriop_set_phy_address(WRIOP1_DPMAC2, 0, 0x0b);
+			break;
+	}
+#endif
+
+	return 0;
