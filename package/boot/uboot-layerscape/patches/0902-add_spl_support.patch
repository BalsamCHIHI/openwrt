+static int _tqmls1088a_bb_set_lane(struct tqc_moment_connect_serdes *serdes, int port, int lane, int proto)
+{
+	serdes->port = port;
+	serdes->lane = lane;
+	switch(proto) {
+		case 0x0: /* Unused */
+			serdes->proto = TQC_MOMENT_CONNECT_SRDS_PROTO_UNUSED;
+			printf("%d:%d TQC_MOMENT_CONNECT_SRDS_PROTO_UNUSED\n", port, lane);
+			break;
+		case 0x1: /* XFI */
+			serdes->proto = TQC_MOMENT_CONNECT_SRDS_PROTO_XFI;
+			printf("%d:%d TQC_MOMENT_CONNECT_SRDS_PROTO_XFI\n", port, lane);
+			break;
+		case 0x2: /* 2.5G SGMII */
+			serdes->proto = TQC_MOMENT_CONNECT_SRDS_PROTO_SGMII2G5;
+			printf("%d:%d TQC_MOMENT_CONNECT_SRDS_PROTO_SGMII2G5\n", port, lane);
+			break;
+		case 0x3: /* SGMII */
+			serdes->proto = TQC_MOMENT_CONNECT_SRDS_PROTO_SGMII;
+			printf("%d:%d TQC_MOMENT_CONNECT_SRDS_PROTO_SGMII\n", port, lane);
+			break;
+		case 0x4: /* QSGMII */
+			serdes->proto = TQC_MOMENT_CONNECT_SRDS_PROTO_QSGMII;
+			printf("%d:%d TQC_MOMENT_CONNECT_SRDS_PROTO_QSGMII\n", port, lane);
+			break;
+		case 0x5: /* PCIe x1 */
+		case 0x6: /* PCIe x1 (alternate) */
+			serdes->proto = TQC_MOMENT_CONNECT_SRDS_PROTO_PCIEx1;
+			printf("%d:%d TQC_MOMENT_CONNECT_SRDS_PROTO_PCIEx1\n", port, lane);
+			break;
+		case 0x7: /* PCIe x2 */
+			serdes->proto = TQC_MOMENT_CONNECT_SRDS_PROTO_PCIEx2;
+			printf("%d:%d TQC_MOMENT_CONNECT_SRDS_PROTO_PCIEx2\n", port, lane);
+			break;
+		case 0x8: /* PCIe x4 */
+			serdes->proto = TQC_MOMENT_CONNECT_SRDS_PROTO_PCIEx4;
+			printf("%d:%d TQC_MOMENT_CONNECT_SRDS_PROTO_PCIEx4\n", port, lane);
+			break;
+		case 0x9: /* SATA */
+			serdes->proto = TQC_MOMENT_CONNECT_SRDS_PROTO_SATA;
+			printf("%d:%d TQC_MOMENT_CONNECT_SRDS_PROTO_SATA\n", port, lane);
+			break;
+		default: /* Undefined */
+			serdes->proto = -1;
+			printf("%d:%d Undefined\n", port, lane);
+			break;
+	}
+
+	return 0;
+}
